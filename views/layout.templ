package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.main-grid {
					display: grid;
					grid-template-columns: 2fr 1fr;
					gap: 2rem;
					align-items: start;
				}
				.panel-box {
					border: 1px solid #d1d5db;
					border-radius: 8px;
					padding: 1.5rem;
					background: #ffffff;
				}
				.acciones-cell details > summary {
					display: flex;
					align-items: center;
					justify-content: space-between;
					white-space: nowrap;
				}

				.acciones-cell details > summary::after {
					float: none;
					margin-inline-start: 0.5rem;
				}
				.inline-form {
					margin: 0;
				}
				table th,
				table td {
					text-align: center;
					vertical-align: middle;
				}
				@media (max-width: 900px) {
					.main-grid {
						grid-template-columns: 1fr;
					}
				}
				#alerta {
					background-color: #f8d7da;
					color: #842029;
					border: 1px solid #f5c2c7;
					border-radius: 8px;
					padding: 1rem;
					margin-bottom: 1rem;
				}

				#alerta:empty {
					display: none;
				}
			</style>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" 
          		integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
          		crossorigin="anonymous"></script>
		</head>
		<body>
			<header class="container">
				<nav>
					<ul>
						<li><strong>Foro - Trabajo de Cursada</strong></li>
					</ul>
					<ul>
						<li><a href="/usuarios">Usuarios</a></li>
						<li><a href="/mensajes">Mensajes</a></li>
					</ul>
				</nav>
				<hr/>
			</header>
			<main class="container">
				<div id="alerta"></div>
				{ children... }
			</main>
		</body>
	</html>
}

templ Alerta(err string) {
    <div id="alerta" hx-swap-oob="true">
        if err != "" {
            <div class="alert-danger" role="alert">
                { err }
            </div>
        }
    </div>
}