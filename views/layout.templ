package views

templ Layout(title string, err string) {
	<!DOCTYPE html>
	<html lang="es" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.main-grid {
					display: grid;
					grid-template-columns: 2fr 1fr;
					gap: 2rem;
					align-items: start;
				}
				.panel-box {
					border: 1px solid #d1d5db;
					border-radius: 8px;
					padding: 1.5rem;
					background: #ffffff;
				}
				.acciones-cell {
					display: flex;
					gap: 0.5rem;
					align-items: center;
				}
				.inline-form {
					margin: 0;
				}
				@media (max-width: 900px) {
					.main-grid {
						grid-template-columns: 1fr;
					}
				}
			</style>
		</head>
		<body>
			<header class="container">
				<nav>
					<ul>
						<li><strong>Foro - Trabajo de Cursada</strong></li>
					</ul>
					<ul>
						<li><a href="/usuarios">Usuarios</a></li>
						<li><a href="/mensajes">Mensajes</a></li>
					</ul>
				</nav>
				<hr/>
			</header>
			<main class="container">
                if err != "" {
                    <div style="background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;" role="alert">
                        { err }
                    </div>
                }
				{ children... }
			</main>
		</body>
	</html>
}

templ Alerta(err string) {
    <div class="alert alert-danger" role="alert">
        { err }
    </div>
}