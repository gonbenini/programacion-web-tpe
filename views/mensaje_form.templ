package views

templ MensajeForm() {
	<aside class="panel-box">
		<h3>Crear Mensaje</h3>
		<form hx-post="/mensajes" hx-target="#tabla-mensajes" hx-swap="outerHTML">
			<label for="usuario">
				ID usuario
				<input type="text" id="usuario" name="usuario" placeholder="Ej: 23" required/>
			</label>
			<label for="respuesta_a">
				ID mensaje respuesta
				<input type="text" id="respuesta" name="respuesta" placeholder="Ej: 11"/>
			</label>
			<label for="texto">
				Texto
				<input type="text" id="texto" name="texto" placeholder="Ej: Me gusta templ..." required/>
			</label>
			<button type="submit">Crear</button>
		</form>
	</aside>
}