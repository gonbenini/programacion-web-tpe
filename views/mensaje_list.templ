
package views

import (
	"fmt"
	"strconv"
	sqlc "foro/internal/db/sqlc"
)

templ MensajeList(mensajes []sqlc.Mensaje) {
	<section class="panel-box" id="tabla-mensajes">
		<h3>Listado de Mensajes</h3>
		if len(mensajes) == 0 {
			<p>No hay mensajes registrados.</p>
		} else {
			<div class="overflow-auto">
				<table>
					<thead>
						<tr>
							<th>ID</th>
							<th>Autor</th>
							<th>Respuesta a</th>
							<th>Texto</th>
							<th>Me gusta</th>
							<th>Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range mensajes {
							 {{
								idUsuario := ""
								idRespuestaAmensaje := ""
								meGusta := int32(0)

								if m.IDUsuario.Valid {
									idUsuario = strconv.Itoa(int(m.IDUsuario.Int32))
								}

								if m.IDRespuestaAMensaje.Valid {
									idRespuestaAmensaje = strconv.Itoa(int(m.IDRespuestaAMensaje.Int32))
								}

								if m.MeGusta.Valid {
									meGusta = m.MeGusta.Int32
								}
							}}

							<tr>
								<td>{ m.IDMensaje }</td>
								<td>{ idUsuario }</td>
								<td>{ idRespuestaAmensaje }</td>
								<td>{ m.Texto }</td>
								<td>{ meGusta }</td>
								<td>
									<div class="acciones-cell">
										<details>
											<summary role="button" class="secondary outline">Editar</summary>
											<form
												hx-put={ fmt.Sprintf("/mensajes/%d", m.IDMensaje) }
												hx-target="#tabla-mensajes"
												hx-swap="outerHTML"
												style="margin-top: 0.5rem; min-width: 220px;">
												
												<input type="hidden" name="id_mensaje" value={ m.IDMensaje }/>
												<input type="number" name="id_usuario" value={ idUsuario } placeholder="Usuario"/>
												<input type="number" name="id_respuesta_a_mensaje" value={ idRespuestaAmensaje } placeholder="Respuesta a"/>
												<input type="text" name="texto" value={ m.Texto } required/>
												<input type="number" name="me_gusta" value={ meGusta }/>
												<button type="submit">Guardar</button>
											</form>
										</details>
										<button type="submit" class="contrast"
											hx-delete={ fmt.Sprintf("/mensajes/%d", m.IDMensaje) }
											hx-target="closest tr"
											hx-confirm="Esta seguro que quiere eliminar?">
											
											Borrar
										</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}